# Vercel Postgres tomonidan avtomatik beriladi (Storage -> Postgres -> .env.local'ga nusxa)
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# Vercel Blob tomonidan avtomatik beriladi (Storage -> Blob -> Connect)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxx"

# JWT imzolash uchun tasodifiy uzun matn (openssl rand -base64 48)
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# Boshlang'ich ustoz hisobi (faqat seed uchun, productionda o'zgartiring)
SEED_TEACHER_LOGIN="ustoz"
SEED_TEACHER_PASSWORD="ustoz1"

# Umumiy resurs monitoring paneli uchun shartli kvota (baytlarda). Masalan 5 GB:
STORAGE_QUOTA_BYTES="5368709120"
